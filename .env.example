# Скопируйте в .env и заполните — приложение подхватит при сборке (EXPO_PUBLIC_* попадают в клиент).
# Пусто — сервер не подключён: всё работает офлайн, отметки копятся в очереди на телефоне.

# REST API бэкенда. Для Supabase: https://<project>.supabase.co/rest/v1
EXPO_PUBLIC_API_URL=
# Публичный ключ клиента (Supabase → Project Settings → API → anon public). Не секрет.
EXPO_PUBLIC_API_KEY=

# Аналитика: console (вывод в консоль), none, appmetrica (после подключения адаптера в src/services/analytics.ts)
EXPO_PUBLIC_ANALYTICS=none
# Ключ аналитики (AppMetrica → Настройки приложения → API key)
EXPO_PUBLIC_ANALYTICS_KEY=
